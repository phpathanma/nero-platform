# Solo variables públicas de Supabase pueden usar NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICABLE

# Enlaces sociales de la portada.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/neroclub_pe/
# ID de playlist pública (el fragmento después de /playlist/ en Spotify).
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=

# Opcional: envío de entradas por correo (requiere dominio verificado en Resend).
RESEND_API_KEY=
TICKET_FROM_EMAIL=
# In production, use the canonical public site URL.
NEXT_PUBLIC_SITE_URL=
# Turnstile es requerido en produccion para proteger Free Access.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Esta clave SOLO se configura en Vercel/servidor cuando se implemente.
# Nunca usar NEXT_PUBLIC_ para una service role key.
SUPABASE_SERVICE_ROLE_KEY=
